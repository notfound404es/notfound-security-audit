{
  "version": "1.0.0",
  "notes": "Secret detectors. Matches are always redacted in reports. 'status' is suspected: the agent must confirm whether the value is real, still valid and reachable by attackers (committed, shipped to the browser, logged).",
  "placeholders": ["example", "changeme", "change_me", "your_", "your-", "xxxx", "<", "${", "{{", "process.env", "env(", "getenv", "os.environ", "dummy", "placeholder", "redacted", "****", "...", "secret_here", "insert", "todo", "fake", "sample", "test123", "password123"],
  "rules": [
    {"id": "aws-access-key-id", "title": "AWS access key ID", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b", "severity": "critical"},
    {"id": "github-token", "title": "GitHub token", "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b|\\bgithub_pat_[A-Za-z0-9_]{60,255}\\b", "severity": "critical"},
    {"id": "gitlab-token", "title": "GitLab personal access token", "pattern": "\\bglpat-[A-Za-z0-9_-]{20,}\\b", "severity": "critical"},
    {"id": "openai-api-key", "title": "OpenAI API key", "pattern": "\\bsk-(?:proj|svcacct|admin)-[A-Za-z0-9_-]{40,}\\b|\\bsk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}\\b", "severity": "critical"},
    {"id": "anthropic-api-key", "title": "Anthropic API key", "pattern": "\\bsk-ant-(?:api|admin)\\d{2}-[A-Za-z0-9_-]{80,}\\b", "severity": "critical"},
    {"id": "stripe-live-key", "title": "Stripe live secret/restricted key", "pattern": "\\b(?:sk|rk)_live_[A-Za-z0-9]{20,}\\b", "severity": "critical"},
    {"id": "stripe-test-key", "title": "Stripe test secret key", "pattern": "\\bsk_test_[A-Za-z0-9]{20,}\\b", "severity": "low"},
    {"id": "slack-token", "title": "Slack token", "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b", "severity": "high"},
    {"id": "slack-webhook", "title": "Slack incoming webhook", "pattern": "https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+", "severity": "medium"},
    {"id": "discord-webhook", "title": "Discord webhook", "pattern": "https://(?:ptb\\.|canary\\.)?discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_-]{30,}", "severity": "medium"},
    {"id": "google-api-key", "title": "Google API key", "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b", "severity": "medium", "hint": "Firebase web keys are designed to be public; what protects the data are Firebase Security Rules and API restrictions. Check them."},
    {"id": "sendgrid-api-key", "title": "SendGrid API key", "pattern": "\\bSG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}\\b", "severity": "high"},
    {"id": "supabase-secret-key", "title": "Supabase secret key", "pattern": "\\bsb_secret_[A-Za-z0-9_-]{20,}\\b", "severity": "critical"},
    {"id": "private-key", "title": "Private key block", "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY(?: BLOCK)?-----", "severity": "critical"},
    {"id": "database-url-with-password", "title": "Database URL with embedded password", "pattern": "\\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis|rediss|amqp)://[^\\s:/@'\"]+:([^\\s@'\"/]{3,})@[^\\s'\"]+", "severity": "high", "secret_group": 1},
    {"id": "generic-secret-assignment", "title": "Hard-coded credential", "pattern": "(?i)\\b(?:password|passwd|pwd|secret|secret_key|api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|private[_-]?key|jwt[_-]?secret)\\b['\"]?\\s*(?:=|:|=>)\\s*['\"]([^'\"\\s]{8,})['\"]", "severity": "medium", "secret_group": 1, "min_entropy": 3.0}
  ]
}
